NODE_ENV=development
PORT=4000
TRUST_PROXY=0
LOG_LEVEL=info
APP_TIMEZONE=Asia/Ho_Chi_Minh

# MongoDB Atlas (mặc định). Lấy chuỗi ở Atlas → Database → Connect → Drivers,
# thêm tên database sau ".net/" (dev: gia-thinh-dev, production: gia-thinh).
# Ký tự đặc biệt trong mật khẩu phải mã hoá URL (vd. @ → %40).
MONGODB_URL=mongodb+srv://<db-user>:<db-password>@<cluster>.xxxxx.mongodb.net/gia-thinh-dev?retryWrites=true&w=majority
# Tuỳ chọn — MongoDB local qua `docker compose up -d`:
# MONGODB_URL=mongodb://127.0.0.1:27017/gia-thinh-dev

# Tối thiểu 32 ký tự, tạo bằng: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_MIN=15
JWT_REFRESH_EXPIRES_DAYS=30

# Danh sách domain front-end, cách nhau bằng dấu phẩy
CORS_ORIGINS=http://localhost:3000
COOKIE_DOMAIN=

# Media luôn lưu trên GCS (bắt buộc GCS_BUCKET). STORAGE_DRIVER=local chỉ dùng khi chạy test,
# hoặc chạy thử offline có chủ đích với ALLOW_LOCAL_STORAGE=true (file ghi vào UPLOAD_DIR).
STORAGE_DRIVER=gcs
ALLOW_LOCAL_STORAGE=false
UPLOAD_DIR=uploads
GCS_BUCKET=
# Dung lượng video tối đa (byte) khi upload thẳng lên GCS bằng signed URL — mặc định 500 MB
MAX_VIDEO_BYTES=524288000
# Đường dẫn file JSON service account (thư viện Google tự đọc), đặt trong thư mục secret/ (đã gitignore)
# vd: GOOGLE_APPLICATION_CREDENTIALS=./secret/gcs-service-account.json
GOOGLE_APPLICATION_CREDENTIALS=
# Để trống: local → http://localhost:PORT/uploads, gcs → https://storage.googleapis.com/<bucket>
PUBLIC_MEDIA_BASE_URL=

# Tài khoản super_admin đầu tiên do `npm run seed` tạo (admin đã có thì seed không đổi mật khẩu)
# Giá trị có ký tự # phải đặt trong nháy kép, vd. SEED_ADMIN_PASSWORD="Abc@123#" (không có nháy, # bị hiểu là chú thích)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PHONE=
SEED_ADMIN_PASSWORD=
